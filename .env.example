DISCORD_BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 以下は任意
# FixTweet系ドメイン (fxtwitter.com / fixupx.com / vxtwitter.com など)
FIX_DOMAIN=fxtwitter.com
# RSSを確認する間隔(秒・最小30)。短いほど速いが、公開Nitterは制限されやすい
POLL_SECONDS=60
# 1フィード・1回の確認で送る最大件数(超えた分は次回に持ち越し)
MAX_SEND_PER_CYCLE=20
# 連投時の送信間隔(秒)
SEND_INTERVAL=1.0

# リツイート・返信を通知しない (0 で通知する)
SKIP_RETWEETS=1
SKIP_REPLIES=1
# Nitterが落ちたときの予備インスタンス(カンマ区切り・任意)
# NITTER_FALLBACKS=https://nitter.example.com,https://nitter.example.org
